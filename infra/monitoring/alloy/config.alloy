// Grafana Alloy Configuration for tomo-service Log Forwarding
// 수집 대상: systemd journal의 tomo.service 유닛 로그만 필터링하여 Grafana Cloud Loki로 전송

// 1. systemd 저널에서 로그 읽기 (path 생략 시 시스템 기본 journal 경로 자동 탐색)
loki.source.journal "tomo_service_journal" {
  max_age       = "12h"
  relabel_rules = discovery.relabel.tomo_filter.rules
  forward_to    = [loki.process.tomo_labels.receiver]
}

// 2. tomo.service 유닛만 필터링하고 로그 레벨 추출
discovery.relabel "tomo_filter" {
  targets = []

  // tomo.service 유닛의 로그만 수집 대상에 포함
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "tomo\\.service"
    action        = "keep"
  }

  // journald 우선순위 키워드를 level 라벨로 매핑 (info, warn, err 등)
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

// 3. Grafana Cloud 대시보드 및 Explore 검색을 위한 식별 라벨 부착
loki.process "tomo_labels" {
  stage.static_labels {
    values = {
      application = "tomo-api",
      environment = "dev",
      job         = "tomo-service",
    }
  }

  forward_to = [loki.write.grafana_cloud_loki.receiver]
}

// 4. Grafana Cloud Loki로 안전하게 전송 (인증 및 전송 실패 시 백오프 재시도/버퍼링)
loki.write "grafana_cloud_loki" {
  endpoint {
    url = sys.env("GCLOUD_HOSTED_LOGS_URL")

    basic_auth {
      username = sys.env("GCLOUD_HOSTED_LOGS_ID")
      password = sys.env("GCLOUD_RW_API_KEY")
    }

    min_backoff_period  = "500ms"
    max_backoff_period  = "5m"
    max_backoff_retries = 10
  }

  // Micro 인스턴스의 디스크 고갈을 방지하기 위해 디스크 WAL을 비활성화하고,
  // 인메모리 버퍼 큐와 최대 10회 백오프 재시도(초과 시 드롭)로 버퍼 상한을 제한
  wal {
    enabled = false
  }
}
